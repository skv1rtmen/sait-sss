    {
      "id": "90da7e54-0ac0-4cc4-83a4-fbaaf69b932f",
      "name": "TG Text",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        896,
        384
      ],
      "parameters": {
        "jsCode": "const r = $input.first().json || {};\nconst f = $('Felder Lesen').first().json || {};\nif (r.ok !== true) return [{ json: { text: 'Website-Anfrage konnte NICHT gespeichert werden: ' + (r.error || '?'), messageThreadId: 0 } }];\nif (r.doppelt === true) return [];\n// Test-Topic \"#60 — Живой тест формы\" wurde am 2026-09-09 nach Abschluss des Livetests geloescht.\n// Alle Website-Anfragen (auch mit utm_source=test*) gehen jetzt in den Haupt-Chat (Thread 0).\nconst zeilen = ['Neue Anfrage über die WEBSITE', '',\n  f.titel || '',\n  (f.name || 'Unbekannt') + ' · ' + (f.telefon || f.email || 'kein Kontakt'),\n  f.ort ? 'Ort: ' + f.ort : '',\n  f.utm_source ? 'Quelle: ' + f.utm_source + (f.utm_term ? ' / ' + f.utm_term : '') : '',\n  '', 'Nummer: ' + (r.nr || '')];\nreturn [{ json: { text: zeilen.filter(function (z) { return z !== ''; }).join('\\n'), messageThreadId: 0 } }];"
      },
      "onError": "continueRegularOutput"
    },
